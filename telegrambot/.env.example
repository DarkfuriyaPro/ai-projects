# ============================================================
#  Telegram AI Bot — Environment Variables
#  Copy this file to .env and fill in your real values.
#  Lines starting with # are comments — they are ignored.
# ============================================================


# ---------------------------
# Telegram (required)
# ---------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here


# ---------------------------
# LLM Provider (required)
# ---------------------------
LLM_API_KEY=your-llm-api-key-here

# Base URL — swap for https://api.openai.com/v1 if using OpenAI directly
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model to use — examples:
#   openai/gpt-3.5-turbo   (cheap, fast)
#   openai/gpt-4o           (smarter, costs more)
#   anthropic/claude-3-haiku (fast and capable)
LLM_MODEL=openai/gpt-3.5-turbo


# ---------------------------
# AI Behaviour (optional)
# ---------------------------

# How creative the responses are: 0.0 = focused, 1.0 = creative
LLM_TEMPERATURE=0.7

# Maximum length of each AI reply (in tokens, roughly 1 token = 1 word)
LLM_MAX_TOKENS=1000

# Seconds to wait for AI response before timing out
LLM_TIMEOUT_SECONDS=30

# How many times to retry if the AI server has a temporary error
LLM_MAX_RETRIES=2

# The personality prompt sent to the AI at the start of every conversation
# SYSTEM_PROMPT=You are a helpful assistant...


# ---------------------------
# Memory (optional)
# ---------------------------

# How many messages to remember per user (user + assistant combined)
MAX_HISTORY_LENGTH=20


# ---------------------------
# Rate Limiting (optional)
# ---------------------------

# Max messages a user can send per time window
RATE_LIMIT_MAX_MESSAGES=10

# Time window in seconds (60 = 1 minute)
RATE_LIMIT_WINDOW_SECONDS=60


# ---------------------------
# Database (optional)
# ---------------------------

# Path to the SQLite file — created automatically on first run
DATABASE_PATH=bot_database.db
